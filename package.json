{
  "name": "cpnow",
  "version": "0.0.6",
  "packageManager": "pnpm@10.11.1",
  "description": "Copy and paste files",
  "author": "onmax",
  "homepage": "https://github.com/onmax/cpnow#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onmax/cpnow.git"
  },
  "bugs": "https://github.com/onmax/cpnow/issues",
  "keywords": [
    "copy",
    "paste",
    "clipboard"
  ],
  "bin": {
    "cpnow": "./bin.mjs"
  },
  "files": [
    "*.mjs",
    "dist"
  ],
  "scripts": {
    "build": "unbuild",
    "dev": "unbuild --stub",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "prepublishOnly": "nr build",
    "release": "bumpp && pnpm publish",
    "start": "tsx src/index.ts",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "citty": "catalog:",
    "clipboardy": "catalog:",
    "consola": "catalog:",
    "ignore": "catalog:",
    "ofetch": "catalog:",
    "pathe": "catalog:",
    "tiny-glob": "catalog:"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:",
    "@types/node": "catalog:",
    "bumpp": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-format": "catalog:",
    "lint-staged": "catalog:",
    "simple-git-hooks": "catalog:",
    "typescript": "catalog:",
    "unbuild": "catalog:",
    "vitest": "catalog:"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
